    },
    {
      "name": "search_series"
    },
    {
      "name": "get_series_history"
    },
    {
      "name": "compare_indicators"
    },
    {
      "name": "get_dashboard_summary"
    },
    {
      "name": "get_data_health"
    },
    {
      "name": "get_series_metadata"
    },
    {
      "name": "build_chart_spec"
    },
    {
      "name": "ask_meridian"
    }
  ]
}
